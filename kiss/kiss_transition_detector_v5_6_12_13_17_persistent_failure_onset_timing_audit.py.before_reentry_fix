        cases,
        key=lambda item: (
            item.timing_group,
            item.onset_minutes,
            item.symbol,
        ),
    ):

        text_path = " -> ".join(
            f"+{minute}m:{state}"
            for minute, state
            in case.state_path
        )

        print()
        print(
            f"{case.symbol:6s} "
            f"{case.direction:5s} "
            f"PF_ONSET=+{case.onset_minutes}m "
            f"GROUP={case.timing_group}"
        )

        print(
            "  "
