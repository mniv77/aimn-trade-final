 <!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Trade Chart View</title>
<script src="https://unpkg.com/lightweight-charts@4.1.0/dist/lightweight-charts.standalone.production.js"></script>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{background:#0b0e11;color:#d1d4dc;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;display:flex;flex-direction:column;height:100vh;overflow:hidden}
header{display:flex;align-items:center;justify-content:space-between;padding:10px 20px;background:#12161c;border-bottom:1px solid #1f2933;flex-wrap:wrap;gap:10px}
h1{font-size:18px;color:#00ffcc}
.controls{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
select,button{background:#1e293b;color:#d1d4dc;border:1px solid #2a2e39;padding:6px 12px;border-radius:6px;cursor:pointer;font-size:14px}
select:hover,button:hover{border-color:#00ffcc;color:#00ffcc}
button.active{background:#0b0e11;color:#00ffcc;border-color:#00ffcc;font-weight:bold}
.filter-group{display:flex;gap:4px}
.back-btn{background:#2a2e39;text-decoration:none;color:#d1d4dc;padding:6px 12px;border-radius:6px;font-size:14px}
.back-btn:hover{background:#3a3f4c}
#chart-container{flex:1;width:100%;display:flex;flex-direction:column}
#main-chart{flex:3;width:100%}
#volume-chart{flex:0.6;width:100%;border-top:1px solid #1f2933}
#rsi-chart{flex:0.8;width:100%;border-top:1px solid #1f2933;display:none}
#rsi-chart.visible{display:block}
.info-bar{display:flex;justify-content:space-between;padding:4px 10px;font-size:11px;color:#868993;background:#12161c}
.toggle{display:flex;align-items:center;gap:6px;font-size:13px}
.toggle input{accent-color:#00ffcc}
</style>
</head>
<body>
<header>
  <h1 id="pageTitle">Trade Review: Loading...</h1>
  <div class="controls">
    <label>Symbol: <select id="symbolSelect"><option value="">All Symbols</option></select></label>
    <label>Select Trade: <select id="tradeSelect"><option value="">-- Choose Trade --</option></select></label>
    <div class="filter-group">
      <button class="filter-btn active" data-filter="All">All</button>
      <button class="filter-btn" data-filter="Losses">Losses</button>
      <button class="filter-btn" data-filter="Small Gainers">Small Gainers</button>
      <button class="filter-btn" data-filter="Winners">Winners</button>
    </div>
    <label class="toggle"><input type="checkbox" id="rsiToggle" checked> Show RSI</label>
    <a href="/trades/" class="back-btn">← Back</a>
  </div>
</header>
<div class="info-bar">
  <div>
    <button data-res="5" class="res-btn active">5m</button>
    <button data-res="15" class="res-btn">15m</button>
    <button data-res="30" class="res-btn">30m</button>
    <button data-res="60" class="res-btn">1hr</button>
    <button data-res="240" class="res-btn">4hr</button>
  </div>
  <div id="rsiInfo">RSI (14) | Entry ≤ 40 | Stop 0.3% | Trailing 1.5%/0.3%</div>
</div>
<div id="chart-container">
  <div id="main-chart"></div>
  <div id="volume-chart"></div>
  <div id="rsi-chart"></div>
</div>
<script>
let mainChart, volumeChart, rsiChart, candleSeries, volumeSeries, rsiSeries, rsiOverbought, rsiOversold, allTrades=[], currentResolution='5';
function initCharts(){
  const mainEl=document.getElementById('main-chart'), volEl=document.getElementById('volume-chart'), rsiEl=document.getElementById('rsi-chart');
  mainChart=LightweightCharts.createChart(mainEl,{layout:{background:{color:'#0b0e11'},textColor:'#d1d4dc'},grid:{vertLines:{color:'#1f2933'},horzLines:{color:'#1f2933'}},timeScale:{timeVisible:true},rightPriceScale:{borderColor:'#2a2e39'}});
  candleSeries=mainChart.addCandlestickSeries({upColor:'#00ff88',downColor:'#ff3344',borderUpColor:'#00ff88',borderDownColor:'#ff3344',wickUpColor:'#00ff88',wickDownColor:'#ff3344'});
  volumeChart=LightweightCharts.createChart(volEl,{layout:{background:{color:'#0b0e11'},textColor:'#d1d4dc'},grid:{vertLines:{color:'#1f2933'},horzLines:{color:'#1f2933'}},timeScale:{visible:false},rightPriceScale:{borderColor:'#2a2e39'}});
  volumeSeries=volumeChart.addHistogramSeries({priceFormat:{type:'volume'}});
  rsiChart=LightweightCharts.createChart(rsiEl,{layout:{background:{color:'#0b0e11'},textColor:'#d1d4dc'},grid:{vertLines:{color:'#1f2933'},horzLines:{color:'#1f2933'}},timeScale:{timeVisible:true},rightPriceScale:{borderColor:'#2a2e39',scaleMargins:{top:0.1,bottom:0.1}}});
  rsiSeries=rsiChart.addLineSeries({color:'#2962ff',lineWidth:2});
  rsiOverbought=rsiChart.addLineSeries({color:'#787b86',lineWidth:1,lineStyle:2});
  rsiOversold=rsiChart.addLineSeries({color:'#ff9800',lineWidth:1,lineStyle:2});
  window.addEventListener('resize',()=>{mainChart.applyOptions({width:mainEl.clientWidth,height:mainEl.clientHeight});volumeChart.applyOptions({width:volEl.clientWidth,height:volEl.clientHeight});rsiChart.applyOptions({width:rsiEl.clientWidth,height:rsiEl.clientHeight});});
}
async function loadTrades(){try{const resp=await fetch('/api/trades/');const data=await resp.json();allTrades=data.trades||data||[];const symSel=document.getElementById('symbolSelect'),tradeSel=document.getElementById('tradeSelect');const symbols=[...new Set(allTrades.map(t=>t.symbol||t.Symbol).filter(Boolean))].sort();symSel.innerHTML='<option value="">All Symbols</option>'+symbols.map(s=>`<option value="${s}">${s}</option>`).join('');tradeSel.innerHTML='<option value="">-- Choose Trade --</option>'+allTrades.map((t,i)=>{const sym=t.symbol||t.Symbol||'UNKNOWN';const pnl=t.pnl||t.PnL||'';const date=(t.entry_time||t.time||'').toString().slice(0,16);return `<option value="${i}">${sym} | ${pnl} | ${date}</option>`;}).join('');}catch(e){console.error(e)}}
async function loadChartData(symbol,resolution){const url=`/api/chart_data/?symbol=${symbol||'BTCUSDT'}&resolution=${resolution||currentResolution}`;try{const r=await fetch(url);const data=await r.json();const candles=data.candles||data.ohlcv||[];const volumes=candles.map(c=>{const isBuy=c.close>=c.open;let col=isBuy?'rgba(0,255,136,0.8)':'rgba(255,51,68,0.8)';if(c.buy_volume!==undefined)col=c.buy_volume>(c.volume/2)?'rgba(0,255,136,0.8)':'rgba(255,51,68,0.8)';return{time:c.time,value:c.volume,color:col};});candleSeries.setData(candles);volumeSeries.setData(volumes);if(data.rsi){const rsiData=data.rsi.map(r=>({time:r.time,value:r.value}));rsiSeries.setData(rsiData);const times=rsiData.map(r=>r.time);if(times.length){rsiOverbought.setData(times.map(t=>({time:t,value:70})));rsiOversold.setData(times.map(t=>({time:t,value:40})));const last=rsiData[rsiData.length-1]?.value?.toFixed(2)||'--';document.getElementById('rsiInfo').textContent=`RSI (14) | Current: ${last} | Entry ≤40 | Stop 0.3% | Trailing 1.5%/0.3%`;}}mainChart.timeScale().fitContent();}catch(e){console.error(e)}}
document.addEventListener('DOMContentLoaded',()=>{initCharts();loadTrades();loadChartData('BTCUSDT',currentResolution);document.querySelectorAll('.res-btn').forEach(btn=>{btn.addEventListener('click',()=>{document.querySelectorAll('.res-btn').forEach(b=>b.classList.remove('active'));btn.classList.add('active');currentResolution=btn.dataset.res;const sym=document.getElementById('symbolSelect').value||'BTCUSDT';loadChartData(sym,currentResolution);});});document.getElementById('rsiToggle').addEventListener('change',e=>{const el=document.getElementById('rsi-chart');if(e.target.checked)el.classList.add('visible');else el.classList.remove('visible');});document.getElementById('rsi-chart').classList.add('visible');document.getElementById('symbolSelect').addEventListener('change',e=>{loadChartData(e.target.value||'BTCUSDT',currentResolution);document.getElementById('pageTitle').textContent=`Trade Review: ${e.target.value||'All Symbols'}`;});document.getElementById('tradeSelect').addEventListener('change',e=>{if(e.target.value==='')return;const t=allTrades[e.target.value];if(t){const sym=t.symbol||t.Symbol;document.getElementById('pageTitle').textContent=`Trade Review: ${sym} | ${t.pnl||''}`;loadChartData(sym,currentResolution);}});});
</script>
</body>
</html>