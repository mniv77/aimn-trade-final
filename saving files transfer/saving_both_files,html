Here is a complete setup for a floating feedback widget designed to capture training data and store it directly in your MySQL database.

1. Database Table Schema
Run this query in your MySQL database to create the storage table for your AIV feedback logs:

SQL
CREATE TABLE IF NOT EXISTS ai_feedback (
    id INT AUTO_INCREMENT PRIMARY KEY,
    rating VARCHAR(50),
    comment TEXT,
    context_data TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
2. Backend Flask Endpoint
Add this route to your web application server using your existing get_db_connection() utility:

Python
from flask import request, jsonify
from db import get_db_connection

@app.route('/api/feedback', methods=['POST'])
def save_feedback():
    data = request.json or {}
    rating = data.get('rating')
    comment = data.get('comment')
    context_data = data.get('context', '')
    
    conn, cur = get_db_connection()
    if not cur:
        return jsonify({'status': 'error', 'message': 'Database connection failed'}), 500
    
    try:
        cur.execute(
            "INSERT INTO ai_feedback (rating, comment, context_data) VALUES (%s, %s, %s)",
            (rating, comment, str(context_data))
        )
        return jsonify({'status': 'success', 'message': 'Feedback stored successfully'})
    except Exception as e:
        return jsonify({'status': 'error', 'message': str(e)}), 500
    finally:
        if cur: cur.close()
        if conn: conn.close()
