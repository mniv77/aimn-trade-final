    <header>

        <h1 id="symbol-title">Trade Review: Loading...</h1>

        <div class="controls">

            <label for="symbol-select">Symbol:</label>

            <select id="symbol-select"></select>



            <label for="trade-select">Select Trade:</label>

            <select id="trade-select"></select>



            <div class="filter-group">

                <button class="filter-btn active" onclick="setFilter('all', event)">All</button>

                <button class="filter-btn" onclick="setFilter('losses', event)">Losses</button>

                <button class="filter-btn" onclick="setFilter('small_gainers', event)">Small Gainers</button>

                <button class="filter-btn" onclick="setFilter('winners', event)">Winners</button>

            </div>



